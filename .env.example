# ============ 应用端口 ============
# 宿主机发布端口（容器内应用固定监听 3000）
CC_PUBLISH_PORT=3086

# ============ 数据库 ============
# PostgreSQL 密码（compose 内部服务名 db，不发布到宿主）
DB_PASS=freshmeal123

# ============ 安全 ============
# JWT 签名密钥，生产环境请务必修改
JWT_SECRET=please-change-me-in-production

# ============ 数据 ============
# 首次启动且数据库为空时写入演示种子数据（true/false）
SEED_ON_EMPTY=true
